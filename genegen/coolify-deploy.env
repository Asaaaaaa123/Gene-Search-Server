# NEXT_PUBLIC_API_URL = 你的 FastAPI 公网根地址（https://...），不要填 sk_ / pk_（那是 Clerk 密钥，填错行会导致构建和 Edge 中间件异常）。
NEXT_PUBLIC_API_URL=https://backend.asagene.aurorarangers.ca

# Clerk Dashboard → API Keys（publishable 与 secret 不要对调）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZnJlZS1zaGluZXItNjIuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_PUBLISHABLE_KEY=pk_test_ZnJlZS1zaGluZXItNjIuY2xlcmsuYWNjb3VudHMuZGV2JA
# Secret key: never commit it. Set CLERK_SECRET_KEY as a Coolify build argument and runtime variable.
CLERK_SECRET_KEY=
